import java.util.*;
public class Main{
    static class TreeNode{
        int val;
        TreeNode left;
        TreeNode right;
        TreeNode (){}
        TreeNode (int val){this.val=val;}
        TreeNode (int val,TreeNode left,TreeNode right){this.val=val;this.left=left;this.right=right;}
    }
    public static void main(String[] args){
        TreeNode root = new TreeNode(1,new TreeNode(2,null,new TreeNode(5)),new TreeNode(3,null,new TreeNode(4)));
        List<Integer> res= new ArrayList<>();
        Deque<TreeNode> de=new ArrayDeque<>();
        de.offerLast(root);
        while(!de.isEmpty()){
           int size=de.size();
           while(size>0){
            TreeNode temp=de.pollFirst();
            if (temp.left!=null)de.offerLast(temp.left);
            if (temp.right!=null)de.offerLast(temp.right);
            size--;
            if(size==0)res.add(temp.val);;
           } 
        }
        System.out.print(res);
    }
}
