import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] nums={1,2,0};
        for(int i=0;i<nums.length;i++){
            if(nums[i]<=0){
                nums[i]=nums.length+1;
            }
        }
        for(int i=0;i<nums.length;i++){
            int temp=Math.abs(nums[i]);
            if(temp<=nums.length){
                nums[temp-1]=-Math.abs(nums[temp-1]);
            }
        }
        for(int i=0;i<nums.length;i++){
            if(nums[i]>0){
                System.out.println(i+1);//res=i+1;
                break;
            }
        }
    }
}
