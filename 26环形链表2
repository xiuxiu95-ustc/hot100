import java.util.*;
public class Main{
    static class ListNode{
        int val;
        ListNode next;
        ListNode (){}
        ListNode (int val){this.val=val;}
        ListNode (int val,ListNode next){this.val=val;this.next=next;}
    }
    public static ListNode buildCycleList(int[] nums,int pos){
        ListNode dummy=new ListNode();
        ListNode cur=dummy;//开始是dummy所以循环里先next
        ListNode cycle=new ListNode();
        for(int i=0;i<nums.length;i++){
            cur.next=new ListNode(nums[i]);
            cur=cur.next;
            if(i==pos){
                cycle=cur;
            }
        }
        if(pos!=-1){
            cur.next=cycle;
        }
        return dummy.next;
    }
    public static void main(String[] args){
        int[] nums={3,2,0,-4};
        ListNode head =buildCycleList(nums,1);

        ListNode fast=head;
        ListNode low=head;
        boolean mark=false;
        ListNode entrance = new ListNode();
        while(fast!=null && fast.next!=null){
            fast=fast.next.next;
            low=low.next;
            if(fast==low){
                mark=true;
                ListNode a=fast;
                ListNode b=head;
                while(a!=b){
                    a=a.next;
                    b=b.next;
                }
                entrance = a;
                break;                
            }
        }
        if (mark) {
            System.out.println("链表有环，环的入口节点值为：" + entrance.val);
        } else {
            System.out.println("链表无环");
        }
    }
}


