import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] nums={1,2,3,4};
        int[] res=new int[nums.length];
        res[0]=1;
        for(int i=1;i<nums.length;i++){
            res[i]=res[i-1]*nums[i-1];
        }
        int suffix=1;
        for(int j=nums.length-1;j>=0;j--){
            res[j]=res[j]*suffix;
            suffix=suffix*nums[j];
        }
        System.out.println(Arrays.toString(res));
    }
}


