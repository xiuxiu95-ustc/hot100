import java.util.*;
public class Main{
    static List<List<String>> res=new ArrayList<>();
    public static void main(String[] args){
        int n=4;
        int[] queens=new int[n];
        boolean[] col=new boolean[n];
        boolean[] diag1=new boolean[n*2-1];
        boolean[] diag2=new boolean[n*2-1];
        dfs(0,queens,col,diag1,diag2);
        System.out.println(res);
    }
    public static void dfs(int r,int[] queens,boolean[] col,boolean[] diag1,boolean[] diag2){
        if(r==queens.length){
            List<String> board=new ArrayList<>();
            for(int c:queens){
                char[] row=new char[queens.length];
                Arrays.fill(row,'.');
                row[c]='Q';
                board.add(new String(row));//字符数组toString()是打印
            }
            res.add(new ArrayList<>(board));
            return;
        }
        for(int c=0;c<queens.length;c++){
            if(!col[c]&& !diag1[r+c] && !diag2[r-c+ queens.length-1]){
                //同一个↗斜线上，所有格子满足 r+c 等于同一个常数
                //同一个↘斜线上，所有格子满足 r-c 相等，加上偏移量 n-1 把它平移到 >=0
                queens[r]=c;
                col[c]=diag1[r+c]=diag2[r-c+ queens.length-1]=true;
                dfs(r+1,queens,col,diag1,diag2);
                col[c]=diag1[r+c]=diag2[r-c+ queens.length-1]=false;
            }
        }
    }
}
