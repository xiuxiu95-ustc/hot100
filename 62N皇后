import java.util.*;
public class Main{
    static List<List<String>> res=new ArrayList<>();
    public static void main(String[] args){
        int n=4;
        int[] queens=new int[n];
        boolean[] col=new boolean[n];
        boolean[] diag1=new boolean[n*2-1];
        boolean[] diag2=new boolean[n*2-1];
        dfs(0,queens,col,diag1,diag2);
        System.out.println(res);
    }
    public static void dfs(int row,int[] queens,boolean[] col,boolean[] diag1,boolean[] diag2){
        if(row==queens.length){
            List<String> path=new ArrayList<>();
            for(int c:queens){
                char[] ca=new char[queens.length];
                Arrays.fill(ca,'.');
                ca[c]='Q';
                path.add(new String(ca));
            }
            res.add(path);
            return;
        }
        for(int c=0;c<queens.length;c++){
            if(!col[c] && !diag1[row+c] && !diag2[row-c+queens.length-1]){
                queens[row]=c;
                col[c]=diag1[row+c]=diag2[row-c+queens.length-1]=true;
                dfs(row+1,queens,col,diag1,diag2);
                col[c]=diag1[row+c]=diag2[row-c+queens.length-1]=false;
            }
        }
    }
}
