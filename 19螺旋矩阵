import java.util.*;
public class Main{
    public static void main(String[] args){
        int[][] matrix = {{1,2,3},{4,5,6},{7,8,9}};
        int m=matrix.length,n=matrix[0].length;
        int l=0,t=0,r=n-1,b=m-1;
        List<Integer> res = new ArrayList<>();
        while(res.size()<m*n){
            for(int i=l;i<=r && res.size()<m*n;i++){
                res.add(matrix[t][i]);
            }
            t++;
            for(int i=t;i<=b && res.size()<m*n;i++){
                res.add(matrix[i][r]);
            }
            r--;
            for(int i=r;i>=l && res.size()<m*n;i--){
                res.add(matrix[b][i]);
            }
            b--;
            for(int i=b;i>=t && res.size()<m*n;i--){
                res.add(matrix[i][l]);
            }
            l++;
        }
        System.out.println(res);
    }
}


