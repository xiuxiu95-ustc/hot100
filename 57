import java.security.PublicKey;
import java.util.*;
public class Main{
    static List<String> res=new ArrayList<>();
    static StringBuilder path =new StringBuilder();
    static String[] sou={"","","abc","def","ghi","jkl","mno","pqrs","tuv","wxyz"};
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String digits=sc.next();
        dfs(digits,0);
        System.out.println(res);
    }
    public static void dfs(String digits,int digitsIndex){
        if(digitsIndex==digits.length()){
            res.add(path.toString());
            return;
        }
        //深度：digitsIndex控制递归深度（处理到第几个数字）
        //宽度：for循环遍历当前数字对应的字母（3或4个选择）
        //也就是说，对应三/四个值怎么分别取出来，是回溯的宽度问题
        char[] ca=abc[digits.charAt(digitsIndex)-'0'].toCharArray();
        for(int i=0;i<ca.length;i++){
            path.append(ca[i]);
            dfs(digits,digitsIndex+1);
            path.deleteCharAt(path.length()-1);
        }
    }
}
//digits = "23"，怎么保证2对应的所有字母和3对应的所有字母都组合一遍并且不重复？只要各自全都遍历就可以，不在同一个集合里不冲突