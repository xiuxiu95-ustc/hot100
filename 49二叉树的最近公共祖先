import java.util.*;
public class Main{
    static class TreeNode{
        int val;
        TreeNode left;
        TreeNode right;
        TreeNode(){}
        TreeNode(int val){this.val=val;}
        TreeNode(int val,TreeNode left,TreeNode right){this.val=val;this.left=left;this.right=right;}
    }
    public static void main(String[] args) {
        // 构建测试二叉树
        TreeNode root = new TreeNode(3,new TreeNode(5),new TreeNode(1));
        root.left.left = new TreeNode(6);root.left.right = new TreeNode(2);
        root.right.left = new TreeNode(0);root.right.right = new TreeNode(8);
        root.left.right.left = new TreeNode(7);root.left.right.right = new TreeNode(4);

        // 指定p=5，q=1，求最近公共祖先
        TreeNode p = root.left;
        TreeNode q = root.right;
        TreeNode res = lowestCommonAncestor(root, p, q);
        System.out.println("最近公共祖先值："+res.val); // 输出 3 ✔️
    }

    public static TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {
        if(root==null ||root==p ||root==q)return root;
        TreeNode left=lowestCommonAncestor(root.left,p,q);
        TreeNode right=lowestCommonAncestor(root.right,p,q);
        if(left==null &&right==null)return null;
        if(left==null)return right;
        if(right==null)return left;
        return root;//left != null && right != null意味着：当前的  root 节点正是我们要找的最近公共祖先！
    }
}