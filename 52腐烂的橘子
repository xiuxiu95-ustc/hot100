import java.util.*;
public class Main{
    static int[][] directions={{1,0},{0,1},{-1,0},{0,-1}};
    public static void main(String[] args){
        int[][] grid = {{2,1,1},{1,1,0},{0,1,1}};
        Deque<int[]> de=new ArrayDeque<>();
        int count=0;
        for(int i=0;i<3;i++){
            for(int j=0;j<3;j++){
                if(grid[i][j]==1){
                    count++;
                }else if(grid[i][j]==2){
                    de.addLast(new int[]{i,j});
                }
            }
        } 
        int minute=0;
        while(count>0 && !de.isEmpty()){
            int size=de.size();
            while(size>0){
                int[] cur=de.pollFirst();
                for(int[] dir:directions){
                    int x=cur[0]+dir[0];
                    int y=cur[1]+dir[1];
                    if((x>=0 &&x<3&&y>=0&&y<3&&grid[x][y]==1)){
                        grid[x][y]=2;
                        de.addLast(new int[]{x,y});
                        count--;
                    }
                }
                size--;
            }
            minute++;
        }
        System.out.println(count!=0?-1:minute);
    }
}
