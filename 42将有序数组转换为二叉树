import java.util.*;
public class Main{
    static class TreeNode{
        int val;
        TreeNode left;
        TreeNode right;
        TreeNode (){}
        TreeNode (int val){this.val=val;}
        TreeNode (int val,TreeNode left,TreeNode right){this.val=val;this.left=left;this.right=right;}
    }
    public static void main(String[] args){
        int[] nums = {-10,-3,0,5,9};
        TreeNode root = dfs(nums, 0,nums.length-1);

        List<List<Integer>> res = levelOrder(root);
        System.out.println(res);
    }
    public static TreeNode dfs(int[] nums,int left,int right){
        if(left>right)return null;
        int mid=left+(right-left)/2;
        TreeNode node=new TreeNode(nums[mid]);
        node.left=dfs(nums,left,mid-1);
        node.right=dfs(nums,mid+1,right);
        return node;
    }
    public static List<List<Integer>> levelOrder(TreeNode root) {
        List<List<Integer>> res= new ArrayList<>();
        Deque<TreeNode> de=new ArrayDeque<>();
        if(root!=null) de.addLast(root);
        while(!de.isEmpty()){
            List<Integer> path=new ArrayList<>();
            int size=de.size();
            while(size>0){
                TreeNode temp=de.pollFirst();
                path.add(temp.val);
                if(temp.left!=null) de.addLast(temp.left);
                if(temp.right!=null) de.addLast(temp.right);
                size--;
            }
            res.add(path);
        }
        return res;
    }
}


