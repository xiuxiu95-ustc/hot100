import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] nums = {2,3,1,1,4};
        int res=0;
        int end=0;
        int nextEnd=0;
        for(int i=0;i<=end;i++){
            if(end>=nums.length-1){
                break;
            }
            nextEnd=Math.max(nextEnd,i+nums[i]);
            if(i==end){
                end=nextEnd;
                res++;
            }
        }
        System.out.println(res);
    }
}
