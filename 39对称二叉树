import java.util.*;
public class Main{
    static class TreeNode{
        int val;
        TreeNode left;
        TreeNode right;
        TreeNode (){}
        TreeNode (int val){this.val=val;}
        TreeNode (int val,TreeNode left,TreeNode right){this.val=val;this.left=left;this.right=right;}
    }
    public static void main(String[] args){
        // 示例1：构建对称二叉树 [1,2,2,3,4,4,3]
        TreeNode root1 = new TreeNode(1);
        root1.left = new TreeNode(2, new TreeNode(3), new TreeNode(4));
        root1.right = new TreeNode(2, new TreeNode(4), new TreeNode(3));

        // 示例2：构建非对称二叉树 [1,2,2,null,3,null,3]
        TreeNode root2 = new TreeNode(1);
        root2.left = new TreeNode(2, null, new TreeNode(3));
        root2.right = new TreeNode(2, null, new TreeNode(3));

        System.out.print(dfs(root2.left,root2.right));
    }
    public static boolean dfs(TreeNode left,TreeNode right){
        if(left==null && right==null)return true;
        if(left !=null && right!=null){
            if(left.val!=right.val)return false;
        }else return false;
        return dfs(left.left,right.right) && dfs(left.right,right.left);
    }
