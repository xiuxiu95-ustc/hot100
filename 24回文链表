import java.util.*;
public class Main{
    static class ListNode{
        int val;
        ListNode next;
        ListNode (){}
        ListNode (int val){this.val=val;}
        ListNode (int val,ListNode next){this.val=val;this.next=next;}
    }
    public static ListNode buildList(int[] nums){
        ListNode dummy=new ListNode();
        ListNode cur=dummy;//开始是dummy所以循环里先next
        for(int num:nums){
            cur.next=new ListNode(num);
            cur=cur.next;
        }
        cur.next=null;
        return dummy.next;
    }
    public static void main(String[] args){
        int[] nums={1,2,3,4,3,2,1};
        ListNode head =buildList(nums);

        ListNode fast=head;
        ListNode low=head;
        while(fast!=null && fast.next!=null){
            fast=fast.next.next;
            low=low.next;
        }

        ListNode pre= null;
        ListNode cur=low;//如果是奇数个，secondNode对应的链表包括中点
        while(cur!=null){
            ListNode temp=cur.next;
            cur.next=pre;
            pre=cur;
            cur=temp;
        }
        ListNode node=pre;

        boolean mark=true;
        while(node!=null){
            if(head.val!=node.val){
                mark=false;
                break;
            }
            head=head.next;
            node=node.next;
        }
        System.out.print(mark);

    }
}


