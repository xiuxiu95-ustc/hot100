import java.util.*;
public class Main{
    static class ListNode{
        int val;
        ListNode next;
        ListNode() {}
        ListNode(int val) { this.val = val; }
        ListNode(int val, ListNode next) {this.val = val; this.next = next; }
    }
    public static ListNode buildList(int[] nums){
        ListNode dummy=new ListNode();
        ListNode cur=dummy;
        for(int i = 0; i < nums.length; i++){
            cur.next=new ListNode(nums[i]);
            cur=cur.next;
        }
        return dummy.next;
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("请输入链表（如 1->3->5）");
        String[] str=sc.nextLine().split("->");
        int[] nums=new int[str.length];
        for(int i=0;i<nums.length;i++){
            nums[i]=Integer.parseInt(str[i]);
        }
        ListNode head=buildList(nums);
        System.out.println("请输入每组翻转的节点数");
        int k=sc.nextInt();

        ListNode dummy=new ListNode();
        dummy.next=head;
        ListNode pre=dummy;
        ListNode end=dummy;//这是重点
        ListNode start=head;
        while(end!=null){
            for(int i=0;i<k &&end!=null;i++){
                end=end.next;
            }
            if(end==null){
                break;
            }
            ListNode mark=end.next;
            end.next=null;
            
            pre.next=reverse(start);
            start.next=mark;

            pre=start;
            start=pre.next;//可以写成start=mark
            end=pre;//end从pre重新开始移动
        }
        //打印,翻转后头节点会变化,要有dummy
        ListNode temp = dummy.next;
        while (temp != null) {
            System.out.print(temp.val);
            temp = temp.next;
            if(temp!=null){
                System.out.print("->");
            }
        }
        System.out.println();
    }
    public static ListNode reverse(ListNode head){
        ListNode pre=null;
        ListNode cur=head;
        while(cur!=null){
            ListNode temp=cur.next;
            cur.next=pre;
            pre=cur;
            cur=temp;
        }
        return pre;//此时cur是null
    }
}