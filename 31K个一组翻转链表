import java.util.*;
public class Main{
    static class ListNode{
        int val;
        ListNode next;
        ListNode (){}
        ListNode (int val){this.val=val;}
        ListNode (int val,ListNode next){this.val=val;this.next=next;}
    }
    public static ListNode buildList(int[] nums){
        ListNode dummy=new ListNode();
        ListNode cur=dummy;//开始是dummy所以循环里先next
        for(int num:nums){
            cur.next=new ListNode(num);
            cur=cur.next;
        }
        cur.next=null;
        return dummy.next;
    }
    public static void main(String[] args){
        int[] nums={1,2,3,4,5};
        ListNode head =buildList(nums);
        int k=2;

        ListNode dummy=new ListNode();
        dummy.next=head;
        ListNode pre=dummy;
        ListNode end=dummy;//这是重点
        ListNode start=head;
        while(end!=null){
            for(int i=0;i<k&& end!=null;i++){
                end=end.next;
            }
            if(end==null)break;
            ListNode mark=end.next;
            end.next=null;

            pre.next=reverse(start);
            start.next=mark;

            pre=start;
            start=mark;
            end=pre;
        }

        ListNode node=dummy.next;
        while(node!=null){
            System.out.print(node.val);
            if(node.next!=null){
                System.out.print("->");
            }
            node=node.next;
        }
    }
    public static ListNode reverse(ListNode head){
        ListNode pre=null;
        ListNode cur=head;
        while(cur!=null){
            ListNode temp=cur.next;
            cur.next=pre;
            pre=cur;
            cur=temp;
        }
        return pre;
    }
}


