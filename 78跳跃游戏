import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] nums = {2,3,1,1,4};
        int end = 0;
        for(int i = 0; i <= end; i++){
            end = Math.max(end, i + nums[i]);
            if(end >= nums.length - 1){
                System.out.println(true);
                return;
            }
        }
        System.out.println(false);
    }
}
