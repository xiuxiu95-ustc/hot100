import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] prices = {7,1,5,3,6,4};
        int[] dp=new int[2];
        dp[0]=-prices[0];
        dp[1]=0;
        for(int i=1;i<prices.length;i++){
            dp[0]=Math.max(dp[0],-prices[i]);
            dp[1]=Math.max(dp[1],dp[0]+prices[i]);
        }
        System.out.println(dp[1]);
    }
}
